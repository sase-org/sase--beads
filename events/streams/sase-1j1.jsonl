{"schema_version":1,"event_id":"sase-1j1:000001:issue_created:sase-1j1:0cd7a237285ecc28517db3adae7eedd00e1b71b688a27458f846144a6efcbd2c","timestamp":"2026-10-09T13:31:11Z","actor":"bbugyi200.athena.0yx","operation":"issue_created","issue_id":"sase-1j1","payload":{"kind":"issue_created","issue":{"id":"sase-1j1","title":"Stop the fleet gateway snapshot stampede that melted apollo","status":"open","issue_type":"plan","tier":"epic","parent_id":null,"owner":"bryanbugyi34@gmail.com","assignee":"","created_at":"2026-10-09T13:31:11Z","created_by":"bbugyi200.athena.0yx","updated_at":"2026-10-09T13:31:11Z","closed_at":null,"close_reason":null,"description":"A slow fleet snapshot rebuild can no longer multiply into hundreds of concurrent index-scanning threads. The gateway runs at most one rebuild per scope, always keeps late results, backs off after failures, bounds its artifact-index work, and logs every build. The artifact index keeps its WAL bounded. Remote clients stop amplifying a slow host. apollo's gateway is restarted only after measurements show it stays healthy under athena's real polling.","design":"plan:202610/apollo_gateway_snapshot_stampede.md","model":"","is_ready_to_work":false,"changespec_name":"","changespec_bug_id":"","creation_reason":"Approved epic plan plan:202610/apollo_gateway_snapshot_stampede.md requests this work","dependencies":[]}}}
