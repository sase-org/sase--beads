{"schema_version":1,"event_id":"sase-19o:000001:issue_created:sase-19o:fd288f82a14549edbe96df1059342f99ac22027b6b70d6479379c104a1c2ea82","timestamp":"2026-09-25T17:51:09Z","actor":"bbugyi200.athena.0s9","operation":"issue_created","issue_id":"sase-19o","payload":{"kind":"issue_created","issue":{"id":"sase-19o","title":"Make sase bead work resilient to agent-name registry drift","status":"open","issue_type":"plan","tier":"epic","parent_id":null,"owner":"bryanbugyi34@gmail.com","assignee":"","created_at":"2026-09-25T17:51:09Z","created_by":"bbugyi200.athena.0s9","updated_at":"2026-09-25T17:51:09Z","closed_at":null,"close_reason":null,"description":"A `sase bead work` retry never plans to launch an agent name that a live or historical owner still holds: registry rebuilds stop dropping in-flight name claims, bead-work cleanup selection repairs (or refuses) any remaining registry drift before it kills anything, and every launch-name conflict is detected before bead-store preclaims, checkpoint commits, or pushes happen.","design":"plan:202609/bead_work_registry_drift_resilience.md","model":"","is_ready_to_work":false,"changespec_name":"","changespec_bug_id":"","dependencies":[]}}}
