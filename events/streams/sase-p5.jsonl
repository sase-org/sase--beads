{"schema_version":1,"event_id":"sase-p5:000001:issue_created:sase-p5:ceb9a3445d69f44408ff26937ced8624c043e130fdb71b7635b95d91e3420f33","timestamp":"2026-08-17T22:55:29Z","actor":"bbugyi200.athena.05d","operation":"issue_created","issue_id":"sase-p5","payload":{"kind":"issue_created","issue":{"id":"sase-p5","title":"Commit finalizer stops failing agents whose work actually landed","status":"open","issue_type":"plan","tier":"epic","parent_id":null,"owner":"bryanbugyi34@gmail.com","assignee":"","created_at":"2026-08-17T22:55:29Z","created_by":"bbugyi200.athena.05d","updated_at":"2026-08-17T22:55:29Z","closed_at":null,"close_reason":null,"description":"An agent whose work is committed and pushed is never marked FAILED by the commit finalizer's discarded-work guard. Commit provenance survives conflict resolution, the finalizer decides attribution from evidence the run itself owns rather than from commit-message footers alone, and a concurrent agent's activity in a shared clone can no longer be misread as this agent discarding its work.","notes":"","design":"plan:202608/commit_finalizer_attribution.md","model":"","is_ready_to_work":false,"changespec_name":"","changespec_bug_id":"","dependencies":[]}}}
