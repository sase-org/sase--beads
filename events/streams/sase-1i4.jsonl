{"schema_version":1,"event_id":"sase-1i4:000001:issue_created:sase-1i4:6a5403e8f5d8bf5ebdb84307f99c1a0c8a7738c416cb4e97215c0d80f107e74d","timestamp":"2026-10-08T10:37:32Z","actor":"bbugyi200.apollo.5s","operation":"issue_created","issue_id":"sase-1i4","payload":{"kind":"issue_created","issue":{"id":"sase-1i4","title":"Agent scopes reap every process an agent leaks","status":"open","issue_type":"plan","tier":"epic","parent_id":null,"owner":"bryanbugyi34@gmail.com","assignee":"","created_at":"2026-10-08T10:37:32Z","created_by":"bbugyi200.apollo.5s","updated_at":"2026-10-08T10:37:32Z","closed_at":null,"close_reason":null,"description":"No process an agent starts outlives its agent runner unless SASE deliberately escaped it into its own systemd scope. Leftovers die when the runner exits (and between in-process successor turns), and a five-minute backstop reaps sase-agent scopes whose runner died without cleaning up, while shared user daemons (ssh-agent, gpg-agent, ssh ControlMaster, tmux server) are never killed.","design":"plan:202610/agent_scope_leak_reaping.md","model":"","is_ready_to_work":false,"changespec_name":"","changespec_bug_id":"","creation_reason":"Approved epic plan plan:202610/agent_scope_leak_reaping.md requests this work","dependencies":[]}}}
